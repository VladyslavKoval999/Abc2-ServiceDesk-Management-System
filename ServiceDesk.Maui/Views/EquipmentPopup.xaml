<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
           x:Class="ServiceDesk.Maui.Views.EquipmentPopup"
           CanBeDismissedByTappingOutsideOfPopup="True"
           Color="Transparent">

    <mct:Popup.Resources>
        <x:Double x:Key="PopupWidth">420</x:Double>
        <x:Double x:Key="PopupTitleSize">22</x:Double>
        <x:Double x:Key="PopupLabelSize">14</x:Double>
        <x:Double x:Key="PopupEntrySize">15</x:Double>
        <x:Double x:Key="PopupButtonSize">15</x:Double>
        <Thickness x:Key="PopupPadding">24,32</Thickness>
    </mct:Popup.Resources>

    <Border x:Name="MainBorder" StrokeShape="RoundRectangle 16" BackgroundColor="#F4F6F9" Padding="{DynamicResource PopupPadding}" WidthRequest="{DynamicResource PopupWidth}" MaximumWidthRequest="500" MaximumHeightRequest="700" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.12" Offset="0,8" Radius="24"/>
        </Border.Shadow>

        <ScrollView VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Spacing="20">

                <Label x:Name="TitleLabel" FontSize="{DynamicResource PopupTitleSize}" FontAttributes="Bold" TextColor="#1A2837" HorizontalOptions="Start" Margin="0,0,0,8" LineBreakMode="WordWrap"/>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label x:Name="LblBrandTitle" Text="{DynamicResource LblBrandReq}" FontSize="{DynamicResource PopupLabelSize}" TextColor="#6C757D" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                        <Border Stroke="#A1AAB2" StrokeThickness="1.5" StrokeShape="RoundRectangle 8" BackgroundColor="White" HeightRequest="44" Padding="14,0">
                            <ScrollView Orientation="Horizontal" VerticalOptions="Center" HorizontalScrollBarVisibility="Never">
                                <Entry x:Name="BrandEntry" BackgroundColor="Transparent" TextColor="#1A2837" FontSize="{DynamicResource PopupEntrySize}" MinimumWidthRequest="250" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0"/>
                            </ScrollView>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label x:Name="LblModelTitle" Text="{DynamicResource LblModelReq}" FontSize="{DynamicResource PopupLabelSize}" TextColor="#6C757D" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                        <Border Stroke="#A1AAB2" StrokeThickness="1.5" StrokeShape="RoundRectangle 8" BackgroundColor="White" HeightRequest="44" Padding="14,0">
                            <ScrollView Orientation="Horizontal" VerticalOptions="Center" HorizontalScrollBarVisibility="Never">
                                <Entry x:Name="ModelEntry" BackgroundColor="Transparent" TextColor="#1A2837" FontSize="{DynamicResource PopupEntrySize}" MinimumWidthRequest="250" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0"/>
                            </ScrollView>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <Label x:Name="LblSerialTitle" Text="{DynamicResource LblColSerialNumber}" FontSize="{DynamicResource PopupLabelSize}" TextColor="#6C757D" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                    <Border Stroke="#A1AAB2" StrokeThickness="1.5" StrokeShape="RoundRectangle 8" BackgroundColor="White" HeightRequest="44" Padding="14,0">
                        <ScrollView Orientation="Horizontal" VerticalOptions="Center" HorizontalScrollBarVisibility="Never">
                            <Entry x:Name="SerialEntry" BackgroundColor="Transparent" TextColor="#1A2837" FontSize="{DynamicResource PopupEntrySize}" MinimumWidthRequest="250" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0"/>
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label x:Name="LblCustomerTitle" Text="{DynamicResource LblCustomerOwner}" FontSize="{DynamicResource PopupLabelSize}" TextColor="#6C757D" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Border Grid.Column="0" Stroke="#A1AAB2" StrokeThickness="1.5" StrokeShape="RoundRectangle 8" BackgroundColor="White" HeightRequest="44" Padding="14,0">
                            <ScrollView Orientation="Horizontal" VerticalOptions="Center" HorizontalScrollBarVisibility="Never">
                                <Picker x:Name="CustomerPicker" ItemDisplayBinding="{Binding FullName}" BackgroundColor="Transparent" TextColor="#1A2837" FontSize="{DynamicResource PopupEntrySize}" MinimumWidthRequest="250" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0"/>
                            </ScrollView>
                        </Border>
                        <Button Grid.Column="1" x:Name="AddCustomerBtn" Text="+" Clicked="OnAddCustomerClicked" BackgroundColor="#0DCAF0" TextColor="White" FontAttributes="Bold" CornerRadius="8" Padding="15,0" HeightRequest="44" FontSize="{DynamicResource PopupButtonSize}"/>
                    </Grid>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="16" Margin="0,16,0,0">
                    <Button x:Name="CancelBtn" Grid.Column="0" Text="{DynamicResource LblCancel}" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="#1A2837" BorderColor="#C7CDD5" BorderWidth="1" CornerRadius="8" FontAttributes="Bold" HeightRequest="48" FontSize="{DynamicResource PopupButtonSize}" LineBreakMode="WordWrap"/>
                    <Button x:Name="SaveButton" Grid.Column="1" Clicked="OnSaveClicked" BackgroundColor="#0DCAF0" TextColor="White" CornerRadius="8" FontAttributes="Bold" HeightRequest="48" FontSize="{DynamicResource PopupButtonSize}" LineBreakMode="WordWrap"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Border>
</mct:Popup>