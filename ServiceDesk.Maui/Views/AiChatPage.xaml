<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ServiceDesk.Shared.Entities;assembly=ServiceDesk.Shared"
             xmlns:controls="clr-namespace:ServiceDesk.Maui.Controls"
             xmlns:selectors="clr-namespace:ServiceDesk.Maui.Selectors"
             x:Class="ServiceDesk.Maui.Views.AiChatPage"
             Title="{DynamicResource LblAiChat}"
             BackgroundColor="{StaticResource AppBackground}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessage">
            <Grid WidthRequest="{Binding Source={x:Reference ChatCollection}, Path=Width}" Padding="10,3" HorizontalOptions="Fill" ColumnDefinitions="25*,75*">
                <Border Grid.Column="1" BackgroundColor="#0DCAF0" HorizontalOptions="Fill" VerticalOptions="Start" Padding="13,8" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>
                    <Label Text="{Binding Text}" FontSize="14" TextColor="White" HorizontalOptions="Fill" VerticalOptions="Center" LineBreakMode="WordWrap" MaxLines="-1" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AiMessageTemplate" x:DataType="models:ChatMessage">
            <Grid WidthRequest="{Binding Source={x:Reference ChatCollection}, Path=Width}" Padding="10,3" HorizontalOptions="Fill" ColumnDefinitions="82*,18*">
                <Border Grid.Column="0" BackgroundColor="#F3F5F8" HorizontalOptions="Fill" VerticalOptions="Start" Padding="13,8" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsError}" Value="True">
                            <Setter Property="BackgroundColor" Value="#FDE8E8" />
                            <Setter Property="Stroke" Value="#F05252" />
                            <Setter Property="StrokeThickness" Value="1" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding Text}" FontSize="14" TextColor="#1A2837" HorizontalOptions="Fill" VerticalOptions="Center" LineBreakMode="WordWrap" MaxLines="-1">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                                <Setter Property="TextColor" Value="#C81E1E" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </Grid>
        </DataTemplate>

        <selectors:ChatMessageTemplateSelector x:Key="ChatSelector" UserTemplate="{StaticResource UserMessageTemplate}" AiTemplate="{StaticResource AiMessageTemplate}" />
    </ContentPage.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="MainPageGrid" Grid.Column="1" RowDefinitions="Auto,*,Auto" Padding="25" RowSpacing="15">

            <Grid x:Name="ToolbarGrid" Grid.Row="0" HeightRequest="50" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                <Border x:Name="MenuBorder" Grid.Column="0" WidthRequest="42" HeightRequest="42" BackgroundColor="Transparent" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuToggled" />
                    </Border.GestureRecognizers>
                    <Path x:Name="MenuBurgerPath" Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Fill="{StaticResource TextPrimary}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="🤖" FontSize="25" VerticalOptions="Center" HorizontalOptions="Center" Margin="2,0,5,0" />
                <Label x:Name="PageTitleLabel" Grid.Column="2" Text="{DynamicResource LblAiChat}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
            </Grid>

            <Border x:Name="ChatBorder" Grid.Row="1" BackgroundColor="{StaticResource CardBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0" HorizontalOptions="Fill" VerticalOptions="Fill">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.04" Offset="0,3" Radius="10" />
                </Border.Shadow>
                <CollectionView x:Name="ChatCollection" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatSelector}" SelectionMode="None" HorizontalOptions="Fill" VerticalOptions="Fill" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Default" ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                </CollectionView>
            </Border>

            <Grid x:Name="InputGrid" Grid.Row="2" HeightRequest="50" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" HeightRequest="50" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 25" Padding="15,0" HorizontalOptions="Fill" VerticalOptions="Center">
                    <Entry x:Name="MessageEntry" Text="{Binding UserInput}" Placeholder="{DynamicResource LblAiPlaceholder}" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" PlaceholderColor="#AAB0B7" FontSize="14" VerticalOptions="Center" HorizontalOptions="Fill" ClearButtonVisibility="WhileEditing" ReturnType="Send" ReturnCommand="{Binding SendMessageCommand}" />
                </Border>
                <Button x:Name="SendButton" Grid.Column="1" WidthRequest="50" HeightRequest="50" CornerRadius="25" Padding="0" Text="➤" FontSize="20" FontAttributes="Bold" BackgroundColor="#0DCAF0" TextColor="White" Command="{Binding SendMessageCommand}" VerticalOptions="Center" />
                <ActivityIndicator x:Name="LoadingIndicator" Grid.Column="1" WidthRequest="24" HeightRequest="24" Color="White" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
            </Grid>
        </Grid>

        <controls:SidebarControl x:Name="AppSidebar" Grid.Column="0" />
    </Grid>

</ContentPage>