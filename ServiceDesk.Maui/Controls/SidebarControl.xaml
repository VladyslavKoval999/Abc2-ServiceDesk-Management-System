<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceDesk.Maui.Controls.SidebarControl"
             Loaded="OnLoaded">
    <Grid>
        <BoxView x:Name="MobileOverlay" BackgroundColor="Black" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="CloseSidebar" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="SidebarPanel" WidthRequest="260" HorizontalOptions="Start" BackgroundColor="{StaticResource SidebarBackground}" StrokeThickness="0">
            <Grid RowDefinitions="Auto, *, Auto">

                <VerticalStackLayout Grid.Row="0">
                    <Grid Padding="20,25,20,15" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label LineBreakMode="TailTruncation">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Abc2 " TextColor="#0DCAF0" FontSize="18" FontAttributes="Bold" />
                                        <Span Text="ServiceDesk" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="Management System" TextColor="#8BA1B8" FontSize="11" />
                        </VerticalStackLayout>

                        <ImageButton x:Name="InnerBurgerBtn" Grid.Column="1" Clicked="CloseSidebar" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                            <ImageButton.Source>
                                <FontImageSource Glyph="✕" Color="#8BA1B8" Size="20" />
                            </ImageButton.Source>
                        </ImageButton>
                    </Grid>
                    <BoxView HeightRequest="1" Color="White" Opacity="0.1" Margin="20,0,20,5" />
                </VerticalStackLayout>

                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="5" Padding="15,10">

                        <Border x:Name="MenuDashboard" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="DashboardPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="⌂" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblDashboardTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuMain" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="MainPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="✎" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblWorkOrdersTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuCustomers" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="CustomersPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="⚇" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblCustomersTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuInventory" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="InventoryPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="☐" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblProductsTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuEquipment" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="EquipmentPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="⛭" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblEquipmentTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuQuotations" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="QuotationsPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="✢" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblQuotationsTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuInvoices" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="InvoicesPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="⍰" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblInvoicesTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuReports" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="ReportsRoute" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="▣" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblReportsTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuSuppliers" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="SuppliersPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="⛃" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblSuppliersTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuPurchasing" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="PurchasingPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="⇄" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblPurchasingTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuTechnicians" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="TechniciansPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="⛭" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblTechniciansTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuAiChat" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="AiChatPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="⚝" TextColor="#0DCAF0" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblAiChat}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="MenuSettings" StrokeThickness="0" BackgroundColor="Transparent" Padding="15,12" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NavigateTo" CommandParameter="SettingsPage" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="⎈" TextColor="#8BA1B8" FontSize="20" WidthRequest="25" HorizontalTextAlignment="Center"/>
                                <Label Text="{DynamicResource LblSettingsTitle}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout Grid.Row="2">
                    <BoxView HeightRequest="1" Color="White" Opacity="0.1" Margin="20,5,20,0" />
                    <Grid Padding="20,15,20,30">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="#152840" StrokeThickness="0" Padding="4" HorizontalOptions="Center" WidthRequest="180" HeightRequest="44">
                            <Grid ColumnDefinitions="*, *">
                                <Border x:Name="BtnLangEn" Grid.Column="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                    <Label x:Name="LblLangEn" Text="EN" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" FontAttributes="Bold"/>
                                </Border>
                                <Border x:Name="BtnLangPt" Grid.Column="1" BackgroundColor="Transparent" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                    <Label x:Name="LblLangPt" Text="PT" TextColor="#8BA1B8" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" FontAttributes="Bold"/>
                                </Border>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLanguageToggledCustom" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>